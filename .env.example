# Copia este archivo como .env y llena lo que vayas a usar. El .env NO se sube
# a git (esta en .gitignore); este .env.example si, sin valores.
#
#   node --env-file=.env scripts/dev.mjs
#
# Todo es opcional en local: sin nada, la app usa data/traveltime.db y crea
# cuentas sin confirmar el correo.

# --- Base de datos (Turso). Sin esto, en local se usa data/traveltime.db ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Correo de confirmacion del registro (Resend) ---
RESEND_API_KEY=
FROM_EMAIL=

# Cerrar el registro publico (1 abierto, 0 cerrado)
ALLOW_SIGNUP=1

# --- Fotos (Cloudflare Images) ---
# Id de la cuenta: Cloudflare -> Imagenes -> Imagenes alojadas -> "Id. de la cuenta"
CF_ACCOUNT_ID=
# Hash de la cuenta: misma pantalla, "Hash de cuenta" (va en las URL de entrega)
CF_ACCOUNT_HASH=
# Token de API: Mi perfil -> Tokens de API -> Crear token, permiso "Cloudflare Images: Edit"
CF_IMAGES_TOKEN=
# Clave para firmar URL: Imagenes -> Claves -> "Clave de firma de URL"
CF_IMAGES_SIGNING_KEY=

# --- Mapas en S3 (solo para subirlos con npm run geo:upload) ---
# Clave de acceso de un usuario de IAM con permiso SOLO sobre el bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
GEO_BUCKET=traveltimealfa
# Dominio de CloudFront delante del bucket (https://dxxxx.cloudfront.net), sin / final
GEO_BASE_URL=

# --- Entrar con Google ---
# ID de cliente OAuth (Aplicacion web) de Google Cloud. No es secreto: va en la pagina.
# Origenes autorizados: https://traveltime-tan.vercel.app y http://localhost:3100
GOOGLE_CLIENT_ID=
# Cuentas nuevas con Google (1 abierto, 0 cerrado). Independiente de ALLOW_SIGNUP,
# que es el registro con contraseña: con Google el correo ya viene verificado.
ALLOW_GOOGLE_SIGNUP=1
